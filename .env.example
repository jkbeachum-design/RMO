SUPABASE_URL=https://hiceshmpjvqfptytlyzo.supabase.co
# service_role / secret key — required for backend inserts (bypasses RLS). NEVER expose to browser.
SUPABASE_KEY=your_service_role_key_here
# publishable / anon — frontend only
SUPABASE_ANON_KEY=your_publishable_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Shared secret for Retell webhook + Next.js proxy (required in production)
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_here
# Optional fallback accepted as webhook secret
RETELL_API_KEY=your_retell_api_key_here
# Supabase Storage bucket for PWA COI/permit/photo uploads
SUPABASE_STORAGE_BUCKET=compliance-documents
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3001
NODE_ENV=development
# Alerts (critical flags) — optional; falls back to console.log
RESEND_API_KEY=
ALERT_FROM_EMAIL=RMO Compliance <alerts@yourdomain.com>
RMO_ALERT_EMAIL=
RMO_ALERT_PHONE=
# Pilot testing safety: when set, ONLY these emails may receive Resend alerts/digests
ALERT_EMAIL_ALLOWLIST=jbeachum@buildmyoffice.com
# Extra blocks (ERICJ379@gmail.com is always blocked in code)
ALERT_EMAIL_BLOCKLIST=
# When set, ONLY these phones may receive Twilio SMS
ALERT_PHONE_ALLOWLIST=
ALERT_PHONE_BLOCKLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DASHBOARD_URL=https://your-frontend.vercel.app
